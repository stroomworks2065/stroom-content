{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1195.002 - AxiosNPMCompromiseIndicatorsWindows",
  "description": "Detects the specific Windows execution chain and process tree associated with the Axios NPM supply chain compromise.\nOn March 30, 2026, malicious versions (1.14.1, 0.30.4) were published to npm, injecting a dependency (plain-crypto-js@4.2.1) that executed a postinstall script as a cross-platform RAT dropper.\nThe dropper contacted a C2 server, delivered platform-specific payloads, deleted itself, and replaced package.json to evade detection.\nThe attack used cscript.exe (VBScript), curl.exe (C2), and PowerShell masquerading as Windows Terminal.\n\n\nLevel: high\n\nStatus: experimental\n\nFalse Positives:\n- Highly unlikely\n\nReferences:\n- https://www.stepsecurity.io/blog/axios-compromised-on-npm-malicious-versions-drop-remote-access-trojan\n- https://thehackernews.com/2026/03/axios-supply-chain-attack-pushes-cross.html?m=1\n- https://www.derp.ca/research/axios-npm-supply-chain-rat/\n- https://www.elastic.co/security-labs/axios-supply-chain-compromise-detections\n- https://www.virustotal.com/gui/file/e10b1fa84f1d6481625f741b69892780140d4e0e7769e7491e5f4d894c2e0e09\n\nTags:\n- attack.initial-access\n- attack.t1195.002\n- attack.execution\n- attack.command-and-control\n- attack.t1059.003\n- attack.t1059.005\n- attack.t1105\n- detection.emerging-threats\n\nSource Sigma rule author(s):\n- Swachchhanda Shrawan Poudel (Nextron Systems)\n\nSource Sigma rule: proc\\_creation\\_win\\_axios\\_npm\\_compromise\\_indicators.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (((EventData.ParentImage = '*\\\\\\\\node.exe' or EventData.ParentImage = '*\\\\\\\\bun.exe') and EventData.Image = '*\\\\\\\\cmd.exe' and (EventData.CommandLine = '*cscript*' or EventData.CommandLine = '*AppData\\\\\\\\Local\\\\\\\\Temp*' or EventData.CommandLine = '*//nologo && del*' or EventData.CommandLine = '*6202033.vbs*')) or ((EventData.Image = '*\\\\\\\\curl.exe' or EventData.Image = '*\\\\\\\\powershell.exe') and EventData.CommandLine = '*http://sfrclak.com*')) or (EventData.OriginalFileName = '*PowerShell.EXE*' and EventData.CommandLine = '*\"C:\\\\\\\\ProgramData\\\\\\\\wt.exe\" -w hidden -ep bypass -file*')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1195_002_proc_creation_win_axios_npm_compromise_indicators",
  "version": "stroomworks_T1195_002_proc_creation_win_axios_npm_compromise_indicators_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "experimental"
}