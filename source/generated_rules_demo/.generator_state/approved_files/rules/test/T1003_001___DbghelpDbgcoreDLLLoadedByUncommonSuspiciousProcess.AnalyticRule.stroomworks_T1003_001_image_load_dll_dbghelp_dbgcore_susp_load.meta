{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - DbghelpDbgcoreDLLLoadedByUncommonSuspiciousProcess",
  "description": "Detects the load of dbghelp/dbgcore DLL by a potentially uncommon or potentially suspicious process.\nThe Dbghelp and Dbgcore DLLs export functions that allow for the dump of process memory. Tools like ProcessHacker, Task Manager and some attacker tradecraft use the MiniDumpWriteDump API found in dbghelp.dll or dbgcore.dll.\nAs an example, SilentTrynity C2 Framework has a module that leverages this API to dump the contents of Lsass.exe and transfer it over the network back to the attacker's machine.\nKeep in mind that many legitimate Windows processes and services might load the aforementioned DLLs for debugging or other related purposes. Investigate the CommandLine and the Image location of the process loading the DLL.\n\n\nLevel: medium\n\nStatus: test\n\nFalse Positives:\n- Debugging scripts might leverage this DLL in order to dump process memory for further analysis.\n\nReferences:\n- https://docs.microsoft.com/en-us/windows/win32/api/minidumpapiset/nf-minidumpapiset-minidumpwritedump\n- https://www.pinvoke.net/default.aspx/dbghelp/MiniDumpWriteDump.html\n- https://medium.com/@fsx30/bypass-edrs-memory-protection-introduction-to-hooking-2efb21acffd6\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n- detection.threat-hunting\n\nSource Sigma rule author(s):\n- Perez Diego (@darkquassar)\n- oscd.community\n- Ecco\n\nSource Sigma rule: image\\_load\\_dll\\_dbghelp\\_dbgcore\\_susp\\_load.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere ((EventData.ImageLoaded = '*\\\\\\\\dbghelp.dll*' or EventData.ImageLoaded = '*\\\\\\\\dbgcore.dll*') and (EventData.Image = '*\\\\\\\\bash.exe' or EventData.Image = '*\\\\\\\\cmd.exe' or EventData.Image = '*\\\\\\\\cscript.exe' or EventData.Image = '*\\\\\\\\dnx.exe' or EventData.Image = '*\\\\\\\\excel.exe' or EventData.Image = '*\\\\\\\\monitoringhost.exe' or EventData.Image = '*\\\\\\\\msbuild.exe' or EventData.Image = '*\\\\\\\\mshta.exe' or EventData.Image = '*\\\\\\\\outlook.exe' or EventData.Image = '*\\\\\\\\powerpnt.exe' or EventData.Image = '*\\\\\\\\regsvcs.exe' or EventData.Image = '*\\\\\\\\rundll32.exe' or EventData.Image = '*\\\\\\\\sc.exe' or EventData.Image = '*\\\\\\\\scriptrunner.exe' or EventData.Image = '*\\\\\\\\winword.exe' or EventData.Image = '*\\\\\\\\wmic.exe' or EventData.Image = '*\\\\\\\\wscript.exe')) and not (((EventData.CommandLine = '*C:\\\\\\\\WINDOWS\\\\\\\\WinSxS\\\\\\\\*' and EventData.CommandLine = '*\\\\\\\\TiWorker.exe -Embedding*') or (EventData.Image = '*\\\\\\\\svchost.exe' and (EventData.CommandLine = '*-k LocalServiceNetworkRestricted*' or EventData.CommandLine = '*-k WerSvcGroup*'))) or (EventData.Image = '*\\\\\\\\rundll32.exe' and (EventData.CommandLine = '*/d srrstr.dll,ExecuteScheduledSPPCreation*' or EventData.CommandLine = '*aepdu.dll,AePduRunUpdate*' or EventData.CommandLine = '*shell32.dll,OpenAs_RunDL*' or EventData.CommandLine = '*Windows.Storage.ApplicationData.dll,CleanupTemporaryState*')))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_image_load_dll_dbghelp_dbgcore_susp_load",
  "version": "stroomworks_T1003_001_image_load_dll_dbghelp_dbgcore_susp_load_v1",
  "type": "AnalyticRule",
  "level": "medium",
  "status": "test"
}