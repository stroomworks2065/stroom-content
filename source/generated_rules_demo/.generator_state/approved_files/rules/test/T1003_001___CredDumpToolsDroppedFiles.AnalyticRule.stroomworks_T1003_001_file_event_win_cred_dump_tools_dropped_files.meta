    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - CredDumpToolsDroppedFiles",
  "description": "Files with well-known filenames (parts of credential dump software or files produced by them) creation\n\nLevel: high\n\nStatus: test\n\nFalse Positives:\n- Legitimate Administrator using tool for password recovery\n\nReferences:\n- https://www.slideshare.net/heirhabarov/hunting-for-credentials-dumping-in-windows-environment\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n- attack.t1003.002\n- attack.t1003.003\n- attack.t1003.004\n- attack.t1003.005\n\nSource Sigma rule author(s):\n- Teymur Kheirkhabarov\n- oscd.community\n\nSource Sigma rule: file\\_event\\_win\\_cred\\_dump\\_tools\\_dropped\\_files.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (((EventData.TargetFilename = '*\\\\\\\\fgdump-log*' or EventData.TargetFilename = '*\\\\\\\\kirbi*' or EventData.TargetFilename = '*\\\\\\\\pwdump*' or EventData.TargetFilename = '*\\\\\\\\pwhashes*' or EventData.TargetFilename = '*\\\\\\\\wce_ccache*' or EventData.TargetFilename = '*\\\\\\\\wce_krbtkts*')) or ((EventData.TargetFilename = '*\\\\\\\\cachedump.exe*' or EventData.TargetFilename = '*\\\\\\\\cachedump64.exe*' or EventData.TargetFilename = '*\\\\\\\\DumpExt.dll*' or EventData.TargetFilename = '*\\\\\\\\DumpSvc.exe*' or EventData.TargetFilename = '*\\\\\\\\Dumpy.exe*' or EventData.TargetFilename = '*\\\\\\\\fgexec.exe*' or EventData.TargetFilename = '*\\\\\\\\lsremora.dll*' or EventData.TargetFilename = '*\\\\\\\\lsremora64.dll*' or EventData.TargetFilename = '*\\\\\\\\NTDS.out*' or EventData.TargetFilename = '*\\\\\\\\procdump.exe*' or EventData.TargetFilename = '*\\\\\\\\procdump64.exe*' or EventData.TargetFilename = '*\\\\\\\\procdump64a.exe*' or EventData.TargetFilename = '*\\\\\\\\pstgdump.exe*' or EventData.TargetFilename = '*\\\\\\\\pwdump.exe*' or EventData.TargetFilename = '*\\\\\\\\SAM.out*' or EventData.TargetFilename = '*\\\\\\\\SECURITY.out*' or EventData.TargetFilename = '*\\\\\\\\servpw.exe*' or EventData.TargetFilename = '*\\\\\\\\servpw64.exe*' or EventData.TargetFilename = '*\\\\\\\\SYSTEM.out*' or EventData.TargetFilename = '*\\\\\\\\test.pwd*' or EventData.TargetFilename = '*\\\\\\\\wceaux.dll*')))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_file_event_win_cred_dump_tools_dropped_files",
  "version": "stroomworks_T1003_001_file_event_win_cred_dump_tools_dropped_files_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "test"
}