  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - HackToolImpacketFileIndicators",
  "description": "Detects file creation events with filename patterns used by Impacket.\n\nLevel: high\n\nStatus: experimental\n\nFalse Positives:\n- Unknown\n\nReferences:\n- https://thedfirreport.com/2025/05/19/another-confluence-bites-the-dust-falling-to-elpaco-team-ransomware/\n- https://github.com/fortra/impacket\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n\nSource Sigma rule author(s):\n- The DFIR Report\n- IrishDeath\n\nSource Sigma rule: file\\_event\\_win\\_impacket\\_file\\_indicators.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.TargetFilename = '*\\\\\\\\\\\\\\\\sessionresume_[a-zA-Z]{8}$*')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_file_event_win_impacket_file_indicators",
  "version": "stroomworks_T1003_001_file_event_win_impacket_file_indicators_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "experimental"
}