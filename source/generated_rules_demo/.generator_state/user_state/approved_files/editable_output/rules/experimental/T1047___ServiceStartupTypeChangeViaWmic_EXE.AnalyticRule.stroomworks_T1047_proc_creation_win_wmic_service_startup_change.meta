{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1047 - ServiceStartupTypeChangeViaWmic.EXE",
  "description": "Detects changes to service startup type to 'disabled' or 'manual' using the WMIC command-line utility.\n\n\nLevel: medium\n\nStatus: experimental\n\nFalse Positives:\n- Legitimate administrative changes to service startup types using WMIC, investigate accordingly.\n\nReferences:\n- https://blog.talosintelligence.com/uncovering-qilin-attack-methods-exposed-through-multiple-cases/\n\nTags:\n- attack.execution\n- attack.defense-impairment\n- attack.t1047\n- attack.t1685\n\nSource Sigma rule author(s):\n- Swachchhanda Shrawan Poudel (Nextron Systems)\n\nSource Sigma rule: proc\\_creation\\_win\\_wmic\\_service\\_startup\\_change.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere ((EventData.Image = '*\\\\\\\\WMIC.exe') or (EventData.OriginalFileName = '*wmic.exe*')) or ((EventData.CommandLine = '* service *' or EventData.CommandLine = '*ChangeStartMode*') and (EventData.CommandLine = '*Manual*' or EventData.CommandLine = '*Disabled*'))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1047_proc_creation_win_wmic_service_startup_change",
  "version": "stroomworks_T1047_proc_creation_win_wmic_service_startup_change_v1",
  "type": "AnalyticRule",
  "level": "medium",
  "status": "experimental"
}