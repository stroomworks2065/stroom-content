{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - CredentialDumpingActivityByPythonBasedTool",
  "description": "Detects LSASS process access for potential credential dumping by a Python-like tool such as LaZagne or Pypykatz.\n\nLevel: high\n\nStatus: stable\n\nFalse Positives:\n- Unknown\n\nReferences:\n- https://twitter.com/bh4b3sh/status/1303674603819081728\n- https://github.com/skelsec/pypykatz\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n- attack.s0349\n\nSource Sigma rule author(s):\n- Bhabesh Raj\n- Jonhnathan Ribeiro\n\nSource Sigma rule: proc\\_access\\_win\\_lsass\\_python\\_based\\_tool.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.TargetImage = '*\\\\\\\\lsass.exe*' and (EventData.CallTrace = '*_ctypes.pyd+*' or EventData.CallTrace = '*:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\KERNELBASE.dll+*' or EventData.CallTrace = '*:\\\\\\\\Windows\\\\\\\\SYSTEM32\\\\\\\\ntdll.dll+*') and (EventData.CallTrace = '*python27.dll+*' or EventData.CallTrace = '*python3*.dll+*') and EventData.GrantedAccess = '0x1FFFFF')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_proc_access_win_lsass_python_based_tool",
  "version": "stroomworks_T1003_001_proc_access_win_lsass_python_based_tool_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "stable"
}