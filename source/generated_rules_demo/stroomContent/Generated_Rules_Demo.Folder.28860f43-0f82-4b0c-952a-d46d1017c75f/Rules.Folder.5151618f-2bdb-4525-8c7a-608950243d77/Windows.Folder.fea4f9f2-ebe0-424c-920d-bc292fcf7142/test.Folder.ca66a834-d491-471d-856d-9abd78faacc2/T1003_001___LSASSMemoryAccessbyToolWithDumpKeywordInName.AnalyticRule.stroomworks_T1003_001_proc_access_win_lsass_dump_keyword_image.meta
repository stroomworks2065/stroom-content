{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - LSASSMemoryAccessbyToolWithDumpKeywordInName",
  "description": "Detects LSASS process access requests from a source process with the \"dump\" keyword in its image name.\n\nLevel: high\n\nStatus: test\n\nFalse Positives:\n- Rare programs that contain the word dump in their name and access lsass\n\nReferences:\n- https://twitter.com/\\_xpn\\_/status/1491557187168178176\n- https://www.ired.team/offensive-security/credential-access-and-credential-dumping/dump-credentials-from-lsass-process-without-mimikatz\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n- attack.s0002\n\nSource Sigma rule author(s):\n- Florian Roth (Nextron Systems)\n\nSource Sigma rule: proc\\_access\\_win\\_lsass\\_dump\\_keyword\\_image.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.TargetImage = '*\\\\\\\\lsass.exe*' and EventData.SourceImage = '*dump*' and (EventData.GrantedAccess = '*10*' or EventData.GrantedAccess = '*30*' or EventData.GrantedAccess = '*50*' or EventData.GrantedAccess = '*70*' or EventData.GrantedAccess = '*90*' or EventData.GrantedAccess = '*B0*' or EventData.GrantedAccess = '*D0*' or EventData.GrantedAccess = '*F0*' or EventData.GrantedAccess = '*18*' or EventData.GrantedAccess = '*38*' or EventData.GrantedAccess = '*58*' or EventData.GrantedAccess = '*78*' or EventData.GrantedAccess = '*98*' or EventData.GrantedAccess = '*B8*' or EventData.GrantedAccess = '*D8*' or EventData.GrantedAccess = '*F8*' or EventData.GrantedAccess = '*1A*' or EventData.GrantedAccess = '*3A*' or EventData.GrantedAccess = '*5A*' or EventData.GrantedAccess = '*7A*' or EventData.GrantedAccess = '*9A*' or EventData.GrantedAccess = '*BA*' or EventData.GrantedAccess = '*DA*' or EventData.GrantedAccess = '*FA*' or EventData.GrantedAccess = '*0x14C2*' or EventData.GrantedAccess = '*FF*'))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_proc_access_win_lsass_dump_keyword_image",
  "version": "stroomworks_T1003_001_proc_access_win_lsass_dump_keyword_image_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "test"
}