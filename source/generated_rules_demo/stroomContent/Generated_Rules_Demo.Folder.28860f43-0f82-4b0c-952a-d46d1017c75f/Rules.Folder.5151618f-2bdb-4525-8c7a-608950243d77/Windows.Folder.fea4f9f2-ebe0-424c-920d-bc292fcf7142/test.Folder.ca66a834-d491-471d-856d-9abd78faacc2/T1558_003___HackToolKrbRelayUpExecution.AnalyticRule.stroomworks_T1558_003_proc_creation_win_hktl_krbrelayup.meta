  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1558.003 - HackToolKrbRelayUpExecution",
  "description": "Detects KrbRelayUp used to perform a universal no-fix local privilege escalation in Windows domain environments where LDAP signing is not enforced\n\nLevel: high\n\nStatus: test\n\nFalse Positives:\n- Unlikely\n\nReferences:\n- https://github.com/Dec0ne/KrbRelayUp\n\nTags:\n- attack.credential-access\n- attack.t1558.003\n- attack.lateral-movement\n- attack.t1550.003\n\nSource Sigma rule author(s):\n- Florian Roth (Nextron Systems)\n\nSource Sigma rule: proc\\_creation\\_win\\_hktl\\_krbrelayup.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere ((((EventData.Image = '*\\\\\\\\KrbRelayUp.exe') or (EventData.OriginalFileName = '*KrbRelayUp.exe*')) or ((EventData.CommandLine = '* relay *' or EventData.CommandLine = '* -Domain *' or EventData.CommandLine = '* -ComputerName *'))) or ((EventData.CommandLine = '* krbscm *' or EventData.CommandLine = '* -sc *'))) or ((EventData.CommandLine = '* spawn *' or EventData.CommandLine = '* -d *' or EventData.CommandLine = '* -cn *' or EventData.CommandLine = '* -cp *'))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1558_003_proc_creation_win_hktl_krbrelayup",
  "version": "stroomworks_T1558_003_proc_creation_win_hktl_krbrelayup_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "test"
}