{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1558.003 - HackToolRemoteKrbRelayExecution",
  "description": "Detects the use of RemoteKrbRelay, a Kerberos relaying tool via CommandLine flags and PE metadata.\n\n\nLevel: high\n\nStatus: test\n\nFalse Positives:\n- Unlikely\n\nReferences:\n- https://github.com/CICADA8-Research/RemoteKrbRelay\n\nTags:\n- attack.credential-access\n- attack.t1558.003\n\nSource Sigma rule author(s):\n- Nasreddine Bencherchali (Nextron Systems)\n\nSource Sigma rule: proc\\_creation\\_win\\_hktl\\_krbrelay\\_remote.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere ((((((EventData.Image = '*\\\\\\\\RemoteKrbRelay.exe') or (EventData.OriginalFileName = '*RemoteKrbRelay.exe*')) or ((EventData.CommandLine = '* -clsid *' or EventData.CommandLine = '* -target *' or EventData.CommandLine = '* -victim *'))) or ((EventData.CommandLine = '*-rbcd *') or ((EventData.CommandLine = '*-cn *' or EventData.CommandLine = '*--computername *')))) or (EventData.CommandLine = '*-chp *' and (EventData.CommandLine = '*-chpPass *' or EventData.CommandLine = '*-chpUser *'))) or ((EventData.CommandLine = '*-addgroupmember *' or EventData.CommandLine = '*-group *' or EventData.CommandLine = '*-groupuser *'))) or ((EventData.CommandLine = '*-smb *' or EventData.CommandLine = '*--smbkeyword *') and (EventData.CommandLine = '*interactive*' or EventData.CommandLine = '*secrets*' or EventData.CommandLine = '*service-add*'))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1558.003_proc_creation_win_hktl_krbrelay_remote",
  "version": "stroomworks_T1558.003_proc_creation_win_hktl_krbrelay_remote_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "test"
}