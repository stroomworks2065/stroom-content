{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - SuspiciousRenamedComsvcsDLLLoadedByRundll32",
  "description": "Detects rundll32 loading a renamed comsvcs.dll to dump process memory\n\nLevel: high\n\nStatus: test\n\nFalse Positives:\n- Unlikely\n\nReferences:\n- https://twitter.com/sbousseaden/status/1555200155351228419\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n\nSource Sigma rule author(s):\n- Nasreddine Bencherchali (Nextron Systems)\n\nSource Sigma rule: image\\_load\\_dll\\_comsvcs\\_load\\_renamed\\_version\\_by\\_rundll32.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.Image = '*\\\\\\\\rundll32.exe' and (EventData.Hashes = '*IMPHASH=eed93054cb555f3de70eaa9787f32ebb*' or EventData.Hashes = '*IMPHASH=5e0dbdec1fce52daae251a110b4f309d*' or EventData.Hashes = '*IMPHASH=eadbccbb324829acb5f2bbe87e5549a8*' or EventData.Hashes = '*IMPHASH=407ca0f7b523319d758a40d7c0193699*' or EventData.Hashes = '*IMPHASH=281d618f4e6271e527e6386ea6f748de*')) and not (EventData.ImageLoaded = '*\\\\\\\\comsvcs.dll*')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_image_load_dll_comsvcs_load_renamed_version_by_rundll32",
  "version": "stroomworks_T1003_001_image_load_dll_comsvcs_load_renamed_version_by_rundll32_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "test"
}