  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - UnsignedImageLoadedIntoLSASSProcess",
  "description": "Loading unsigned image (DLL, EXE) into LSASS process\n\nLevel: medium\n\nStatus: test\n\nFalse Positives:\n- Valid user connecting using RDP\n\nReferences:\n- https://www.slideshare.net/heirhabarov/hunting-for-credentials-dumping-in-windows-environment\n\nTags:\n- attack.credential-access\n- attack.t1003.001\n\nSource Sigma rule author(s):\n- Teymur Kheirkhabarov\n- oscd.community\n\nSource Sigma rule: image\\_load\\_lsass\\_unsigned\\_image\\_load.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.Image = '*\\\\\\\\lsass.exe' and EventData.Signed = 'false')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
