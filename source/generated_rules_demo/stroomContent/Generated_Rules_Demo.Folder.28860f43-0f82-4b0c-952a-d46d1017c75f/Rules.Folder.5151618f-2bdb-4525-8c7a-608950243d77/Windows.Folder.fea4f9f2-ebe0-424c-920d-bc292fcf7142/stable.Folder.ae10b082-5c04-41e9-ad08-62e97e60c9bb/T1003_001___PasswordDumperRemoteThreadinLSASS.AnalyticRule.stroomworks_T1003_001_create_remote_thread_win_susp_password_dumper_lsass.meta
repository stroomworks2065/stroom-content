  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - PasswordDumperRemoteThreadinLSASS",
  "description": "Detects password dumper activity by monitoring remote thread creation EventID 8 in combination with the lsass.exe process as TargetImage.\nThe process in field Process is the malicious program. A single execution can lead to hundreds of events.\n\n\nLevel: high\n\nStatus: stable\n\nFalse Positives:\n- Antivirus products\n\nReferences:\n- https://jpcertcc.github.io/ToolAnalysisResultSheet/details/WCE.htm\n\nTags:\n- attack.credential-access\n- attack.s0005\n- attack.t1003.001\n\nSource Sigma rule author(s):\n- Thomas Patzke\n\nSource Sigma rule: create\\_remote\\_thread\\_win\\_susp\\_password\\_dumper\\_lsass.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.TargetImage = '*\\\\\\\\lsass.exe*' and EventData.StartModule = '')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_create_remote_thread_win_susp_password_dumper_lsass",
  "version": "stroomworks_T1003_001_create_remote_thread_win_susp_password_dumper_lsass_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "stable"
}