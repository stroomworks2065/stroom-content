  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1003.001 - RemoteLSASSProcessAccessThroughWindowsRemoteManagement",
  "description": "Detects remote access to the LSASS process via WinRM. This could be a sign of credential dumping from tools like mimikatz.\n\nLevel: high\n\nStatus: stable\n\nFalse Positives:\n- Unlikely\n\nReferences:\n- https://pentestlab.blog/2018/05/15/lateral-movement-winrm/\n\nTags:\n- attack.credential-access\n- attack.execution\n- attack.t1003.001\n- attack.t1059.001\n- attack.lateral-movement\n- attack.t1021.006\n- attack.s0002\n\nSource Sigma rule author(s):\n- Patryk Prauze - ING Tech\n\nSource Sigma rule: proc\\_access\\_win\\_lsass\\_remote\\_access\\_trough\\_winrm.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere (EventData.TargetImage = '*\\\\\\\\lsass.exe*' and EventData.SourceImage = '*:\\\\\\\\Windows\\\\\\\\system32\\\\\\\\wsmprovhost.exe*') and not (EventData.GrantedAccess = '0x80000000')\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1003_001_proc_access_win_lsass_remote_access_trough_winrm",
  "version": "stroomworks_T1003_001_proc_access_win_lsass_remote_access_trough_winrm_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "stable"
}