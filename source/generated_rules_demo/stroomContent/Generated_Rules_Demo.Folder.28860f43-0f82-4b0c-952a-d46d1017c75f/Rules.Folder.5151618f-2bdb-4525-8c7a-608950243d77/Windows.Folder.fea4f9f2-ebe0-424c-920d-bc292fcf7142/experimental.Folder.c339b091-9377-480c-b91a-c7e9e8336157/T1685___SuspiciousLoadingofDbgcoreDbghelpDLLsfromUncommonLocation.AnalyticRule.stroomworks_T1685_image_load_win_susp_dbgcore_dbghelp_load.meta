{
  "analyticProcessType": "STREAMING",
  "duplicateNotificationConfig": {
    "chooseColumns": false,
    "columnNames": [],
    "rememberNotifications": false,
    "suppressDuplicateNotifications": false
  },
  "errorFeed": {
    "type": "Feed",
    "uuid": "8b95697a-1827-4e67-b982-940f3d47634c",
    "name": "RULE_ERRORS_FEED"
  },
  "includeRuleDocumentation": false,
  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1685 - SuspiciousLoadingofDbgcoreDbghelpDLLsfromUncommonLocation",
  "description": "Detects loading of dbgcore.dll or dbghelp.dll from uncommon locations such as user directories.\nThese DLLs contain the MiniDumpWriteDump function, which can be abused for credential dumping purposes or in some cases for evading EDR/AV detection by suspending processes.\n\n\nLevel: high\n\nStatus: experimental\n\nFalse Positives:\n- Unknown\n\nReferences:\n- https://blog.axelarator.net/hunting-for-edr-freeze/\n- https://www.zerosalarium.com/2025/09/EDR-Freeze-Puts-EDRs-Antivirus-Into-Coma.html\n- https://www.splunk.com/en\\_us/blog/security/you-bet-your-lsass-hunting-lsass-access.html\n\nTags:\n- attack.credential-access\n- attack.defense-impairment\n- attack.t1003\n- attack.t1685\n\nSource Sigma rule author(s):\n- Swachchhanda Shrawan Poudel (Nextron Systems)\n\nSource Sigma rule: image\\_load\\_win\\_susp\\_dbgcore\\_dbghelp\\_load.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere ((EventData.Image = ':\\\\\\\\Perflogs\\\\\\\\' or EventData.Image = ':\\\\\\\\Temp\\\\\\\\' or EventData.Image = ':\\\\\\\\Users\\\\\\\\Public\\\\\\\\' or EventData.Image = '\\\\\\\\$Recycle.Bin\\\\\\\\' or EventData.Image = '\\\\\\\\Contacts\\\\\\\\' or EventData.Image = '\\\\\\\\Documents\\\\\\\\' or EventData.Image = '\\\\\\\\Favorites\\\\\\\\' or EventData.Image = '\\\\\\\\Favourites\\\\\\\\' or EventData.Image = '\\\\\\\\inetpub\\\\\\\\wwwroot\\\\\\\\' or EventData.Image = '\\\\\\\\Music\\\\\\\\' or EventData.Image = '\\\\\\\\Pictures\\\\\\\\' or EventData.Image = '\\\\\\\\Start Menu\\\\\\\\Programs\\\\\\\\Startup\\\\\\\\' or EventData.Image = '\\\\\\\\Users\\\\\\\\Default\\\\\\\\' or EventData.Image = '\\\\\\\\Videos\\\\\\\\')) or ((EventData.ImageLoaded = '*\\\\\\\\dbgcore.dll*' or EventData.ImageLoaded = '*\\\\\\\\dbghelp.dll*'))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
  "uuid": "stroomworks_T1685_image_load_win_susp_dbgcore_dbghelp_load",
  "version": "stroomworks_T1685_image_load_win_susp_dbgcore_dbghelp_load_v1",
  "type": "AnalyticRule",
  "level": "high",
  "status": "experimental"
}