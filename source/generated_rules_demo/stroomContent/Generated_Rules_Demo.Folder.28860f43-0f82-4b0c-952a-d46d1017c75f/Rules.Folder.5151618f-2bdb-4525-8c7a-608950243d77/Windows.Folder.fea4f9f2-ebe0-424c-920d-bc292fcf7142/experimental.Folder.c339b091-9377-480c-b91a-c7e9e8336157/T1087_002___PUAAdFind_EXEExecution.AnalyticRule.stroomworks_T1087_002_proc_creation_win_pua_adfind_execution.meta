  "languageVersion": "STROOM_QL_VERSION_0_1",
  "name": "T1087.002 - PUAAdFind.EXEExecution",
  "description": "Detects execution of Adfind.exe utility, which can be used for reconnaissance in an Active Directory environment\n\nLevel: medium\n\nStatus: experimental\n\nFalse Positives:\n- Unknown\n\nReferences:\n- https://www.joeware.net/freetools/tools/adfind/\n- https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1087.002/T1087.002.md\n\nTags:\n- attack.discovery\n- attack.t1087.002\n\nSource Sigma rule author(s):\n- Swachchhanda Shrawan Poudel (Nextron Systems)\n\nSource Sigma rule: proc\\_creation\\_win\\_pua\\_adfind\\_execution.yml",
  "notifications": [
    {
      "destination": {
        "type": "stream",
        "destinationFeed": {
          "type": "Feed",
          "uuid": "f58bb9a9-1359-4077-9451-f977b2b862c3",
          "name": "RULE_OUTPUT_FEED"
        },
        "useSourceFeedIfPossible": false
      },
      "destinationType": "STREAM",
      "enabled": true,
      "limitNotifications": false,
      "maxNotifications": 1,
      "resumeAfter": {
        "time": 1,
        "timeUnit": "DAYS"
      },
      "uuid": "9ed54c1d-6c2c-41e0-aae1-fe3a25c5f77c"
    }
  ],
  "query": "from RULE_VIEW\nwhere ((EventData.Image = '*\\\\\\\\AdFind.exe') or (EventData.OriginalFileName = '*AdFind.exe*') or ((EventData.Hashes = '*IMPHASH=d144de8117df2beceaba2201ad304764*' or EventData.Hashes = '*IMPHASH=12ce1c0f3f5837ecc18a3782408fa975*' or EventData.Hashes = '*IMPHASH=bca5675746d13a1f246e2da3c2217492*' or EventData.Hashes = '*IMPHASH=4fbf3f084fbbb2470b80b2013134df35*' or EventData.Hashes = '*IMPHASH=49b639b4acbecc49d72a01f357aa4930*' or EventData.Hashes = '*IMPHASH=53e117a96057eaf19c41380d0e87f1c2*' or EventData.Hashes = '*IMPHASH=680dad9e300346e05a85023965867201*' or EventData.Hashes = '*IMPHASH=21aa085d54992511b9f115355e468782*')))\nselect *",
  "rememberNotifications": false,
  "suppressDuplicateNotifications": false,
  "timeRange": {
    "name": "All time",
    "condition": "BETWEEN"
  },
